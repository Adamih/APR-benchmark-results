+    position.setLongitude(buf.readIntLE() * 0.0000001);
+    position.setLatitude(buf.readIntLE() * 0.0000001);
+    buf.skipBytes(15); // remaining coordinates block
 
     buf.skipBytes(3); // data tag header
     decodeMinimalDataSet(position, buf);
 
     return position;
 }
