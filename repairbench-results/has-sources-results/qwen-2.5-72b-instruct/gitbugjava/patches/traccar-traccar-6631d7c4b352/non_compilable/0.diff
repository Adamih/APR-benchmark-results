         if (buf.getByte(i) == ']') {
             endIndex = i + 1;
             break;
         }
     }
 
     if (endIndex > 0) {
         ByteBuf frame = Unpooled.buffer();
+        int originalReaderIndex = buf.readerIndex();
         while (buf.readerIndex() < endIndex) {
