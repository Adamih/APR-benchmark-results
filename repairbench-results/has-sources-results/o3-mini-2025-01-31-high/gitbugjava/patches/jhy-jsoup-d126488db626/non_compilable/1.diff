     StringBuilder sq = StringUtil.borrowBuilder();
     while (!tq.isEmpty()) {
+        // If a comma is encountered, it's a query group separator; stop consuming.
+        if (tq.matches(",")) break;
         if (tq.matches("("))
             sq.append("(").append(tq.chompBalanced('(', ')')).append(")");
