     StringBuilder sq = StringUtil.borrowBuilder();
     while (!tq.isEmpty()) {
+        // End the subquery when a comma is encountered.
+        if (tq.matches(","))
+            break;
         if (tq.matches("("))
             sq.append("(").append(tq.chompBalanced('(', ')')).append(")");
