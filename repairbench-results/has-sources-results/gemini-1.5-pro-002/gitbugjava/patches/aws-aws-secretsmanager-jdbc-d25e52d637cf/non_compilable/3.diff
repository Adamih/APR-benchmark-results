     public String constructUrlFromEndpointPortDatabase(String endpoint, String port, String dbname) {
         String url = "jdbc:postgresql://" + endpoint;
         if (!StringUtils.isNullOrEmpty(port)) {
             url += ":" + port;
         }
         if (!StringUtils.isNullOrEmpty(dbname)) {
             url += "/" + dbname;
