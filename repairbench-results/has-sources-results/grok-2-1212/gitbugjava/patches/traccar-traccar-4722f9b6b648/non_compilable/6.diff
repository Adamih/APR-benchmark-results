+    Date date = new Date(timestamp * 1000); // Convert seconds to milliseconds
+    position.setTime(date);
 
     buf.skipBytes(23); // coordinates block
 
     buf.skipBytes(3); // data tag header
     decodeMinimalDataSet(position, buf);
 
     return position;
 }
