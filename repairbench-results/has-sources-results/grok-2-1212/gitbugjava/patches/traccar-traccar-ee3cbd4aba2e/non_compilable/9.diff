+                    buf.readBytes(tiltData);
+                    int x = (int) tiltData[0];
+                    int y = (int) tiltData[2];
+                    int z = (int) tiltData[4];
+                    position.set("tilt", "[" + (x > 127 ? x - 256 : x) + "," + (y > 127 ? y - 256 : y) + "," + (z > 127 ? z - 256 : z) + "]");
