+private String getDisplayStyle() {
+    String style = attributes.get("style");
+    if (style == null) {
+        return null;
+    }
+    Matcher m = Pattern.compile("(?i)\\bdisplay\\s*:\\s*([^;]+)", Pattern.MULTILINE).matcher(style);
+    if (m.find()) {
+        return m.group(1).trim();
+    }
+    return null;
